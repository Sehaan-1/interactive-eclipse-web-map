# ==============================================================================
# Celestial Atlas & Observatory - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite and bundler build artifacts
dist/
dist-ssr/
build/
out/
.vite/
.turbo/
.cache/
*.tsbuildinfo
.eslintcache

# Package manager local stores & Yarn v2+
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
.env_*/

# Python logs and diagnostics
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 3. Astronomical Data & Ephemeris BSP Cache
# ------------------------------------------------------------------------------
# NASA JPL Ephemeris Binary SPK files and timescale predictions
*.bsp
*.tpc
*.tf
*.tls
*.bpc
de421.bsp
de440.bsp
de430.bsp
deltat.data
deltat.preds
Leap_Second.dat
.skyfield-data/
skyfield-data/

# ------------------------------------------------------------------------------
# 4. Testing, Code Coverage & Profiling
# ------------------------------------------------------------------------------
# Unit and integration testing caches
.pytest_cache/
.hypothesis/
.nox/
.tox/
coverage/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.nyc_output/

# End-to-end testing (Playwright, Cypress)
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# 5. Environment Variables & Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example
!*.env.sample
!*.env.template

# Keys, certificates, and credentials
*.pem
*.key
*.crt
*.pfx
*.p12
credentials.json
secrets.json

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
# Visual Studio Code (track configuration templates, ignore workspace local data)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.ionide/

# JetBrains (IntelliJ IDEA, WebStorm, PyCharm)
.idea/
*.iws
*.iml
*.ipr
out/

# Visual Studio
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln.docstates

# Sublime Text & TextMate
*.sublime-project
*.sublime-workspace
*.tmproj
*.tmproject

# Vim / Emacs / Nano swap and backup files
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
*~
*.bak
*.tmp
*.temp
\#*\#
.#*

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*
.fuse_hidden*

# ------------------------------------------------------------------------------
# 8. Temporary Logs & Diagnostic Files
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock
